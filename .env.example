# Copy to .env.local and fill in. Never commit real values — .gitignore covers
# .env* with an explicit exception for this template only.
#
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle and must be
# treated as public. Everything else stays server-side.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Required by the import scripts AND, since RLS was
# enabled on the position tables (scripts/enable-rls-portfolio.sql), by the
# deployed /portfolio page itself — so this must be set in Vercel, not just
# locally and in GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=

# --- Portfolio lock ---------------------------------------------------------
# Gates /portfolio. See lib/portfolioLock.ts and SECURITY.md.
#
# The password is typed roughly once a month, so make it long and random from a
# password manager — there is no cross-instance rate limiting to lean on.
PORTFOLIO_PASSWORD=

# Signs the unlock cookie. Must be high-entropy and distinct from the password:
# forging a cookie then requires this secret, while guessing the password stays
# an online attack. Generate with:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing either var invalidates all existing unlock cookies.
PORTFOLIO_COOKIE_SECRET=

# --- Market & macro data ----------------------------------------------------
FINNHUB_API_KEY=
FRED_API_KEY=

# --- AI ---------------------------------------------------------------------
GEMINI_API_KEY=

# --- Web push ---------------------------------------------------------------
# Generate a keypair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
